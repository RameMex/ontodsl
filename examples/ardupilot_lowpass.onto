schema "onto/0.1";
namespace ardupilot_filters;

// =====================================================================
// UFO-A model of ArduPilot's libraries/Filter/LowPassFilter.{h,cpp}.
//
// Source studied:
//   https://github.com/ArduPilot/ardupilot/blob/master/libraries/Filter/LowPassFilter.h
//   https://github.com/ArduPilot/ardupilot/blob/master/libraries/Filter/LowPassFilter.cpp
//
// The C++ class hierarchy is:
//   DigitalLPF<T>             — base, holds output + initialised
//   LowPassFilterConstDt<T>   — pre-computes alpha from sample_freq
//   LowPassFilter<T>          — recomputes alpha per call with dt
//
// Modeled here as one Kind (DigitalLPF) and two Subkinds, since they
// share identity (a filter object remains the same filter object
// through its life) and the subkinds only specialise the apply event.
//
// Pre-conditions in the original C++ are IMPLICIT (caller's
// responsibility); we make them EXPLICIT here so the generated Rust
// wrapper enforces them at runtime — that's the whole point of doing
// DbC migration.
// =====================================================================

kind DigitalLPF {
  identity: filterId;

  property filterId: String;
  property output: Real;
  property initialised: Boolean;

  invariants {
    self.filterId <> null;
  }

  event reset(value: Real) {
    post: self.output = value;
    post: self.initialised = true;
    modifies: self.output, self.initialised;
  }

  event reset_flag() {
    post: self.initialised = false;
    modifies: self.initialised;
  }

  // Mirrors C++ DigitalLPF<T>::_apply:
  //   output += (sample - output) * alpha;
  //   if (!initialised) { initialised = true; output = sample; }
  //   return output;
  //
  // Net effect, given the order of statements:
  //   if initialised@pre == false  ->  output@post = sample
  //   if initialised@pre == true   ->  output@post = output@pre + (sample - output@pre) * alpha
  //
  // The alpha bound is a DbC obligation the original C++ never checks.
  event apply_internal(sample: Real, alpha: Real) {
    pre: alpha >= 0.0;
    pre: alpha <= 1.0;

    post: if self.initialised@pre then
            self.output = self.output@pre + (sample - self.output@pre) * alpha
          else
            self.output = sample
          endif;
    post: self.initialised = true;

    modifies: self.output, self.initialised;
  }
}

// LowPassFilter<T> in C++: variable dt, recomputes alpha each apply().
// Inherits identity from DigitalLPF.
subkind LowPassFilter specializes DigitalLPF {
  property cutoffFreq: Real;

  invariants {
    self.cutoffFreq >= 0.0;
  }

  event set_cutoff_frequency(newCutoffFreq: Real) {
    pre: newCutoffFreq >= 0.0;
    post: self.cutoffFreq = newCutoffFreq;
    modifies: self.cutoffFreq;
  }

  // C++:
  //   const float alpha = calc_lowpass_alpha_dt(dt, cutoff_freq);
  //   return this->_apply(sample, alpha);
  //
  // LSP rule: precondition of this apply MUST be weaker-or-equal than
  // the parent's apply_internal. Parent requires alpha in [0,1].
  // We require dt >= 0; the alpha returned by calc_lowpass_alpha_dt
  // with non-negative dt and non-negative cutoffFreq is in [0,1] by
  // construction, so the parent's contract is satisfied.
  event apply(sample: Real, dt: Real) {
    pre: dt >= 0.0;

    post: self.initialised = true;
    modifies: self.output, self.initialised;
  }
}
