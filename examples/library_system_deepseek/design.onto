schema "onto/0.1";
namespace library_system_design;
import "./discovery.onto";
import "./requirements.onto";
import "./formalization.onto";

// =====================================================================
// Design Stage — Component Decomposition
// =====================================================================
// Components (kinds):
//   - CopyInventory      : owns BookCopy status + state transitions
//   - BorrowerRegistry   : owns Borrower fees + loan eligibility
//   - LoanLedger         : owns Loan records + late fee computation
//   - ReservationManager : owns Reservation lifecycle + expiry
//   - AuditLogger        : owns state transition log --- documentary
//
// Each component is a sibling 'kind' (NOT subkind of LibrarySystem).
// Events refine requirements-level events via structured 'refines:' clause.
// Interfaces between components are modeled as 'relator' with 'role' endpoints.
// Data flows crossing component boundaries are modeled as 'happening'.
//
// FIXES:
// - Added 'identity: flowId;' to FullLoanFlow and ReturnFlow
// - Removed .toString calls on Real (S27) — use a helper flag instead
// =====================================================================

// ─── Component: CopyInventory ─────────────────────────────────────────
// Owns BookCopy status & the exclusivity invariant (GOAL-1).

kind CopyInventory {
  identity: inventoryId;
  property inventoryId: String;

  // Local copy of status per copyId (maps would be ideal, but we use
  // a simplified flat structure for OCL decidability).
  property copyStatuses: Set<BookCopy>;

  invariants {
    self.inventoryId <> null;
    // Every copy in the set has a valid status (the set itself ensures
    // uniqueness via copy identity — we document the constraint).
    self.copyStatuses->forAll(c | c.status = 'AVAILABLE' or c.status = 'LOANED' or c.status = 'RESERVED');
  }

  // ── FR-1 contribution: check copy is AVAILABLE ────────────────────
  event verifyCopyAvailable(copyId: String): Boolean
    refines library_system_requirements::LibrarySystem.requestLoan,
            library_system_formalization::LibrarySystemFormalized.enforceCopyAvailabilityCheck {
    pre: copyId <> null;
    // In a real system, we'd look up the copy in the set. Here we use
    // the set to model the check.
    post: result = self.copyStatuses->exists(c | c.copyId = copyId and c.status = 'AVAILABLE');
    modifies: self.inventoryId;
  }

  // ── Copy state transitions ────────────────────────────────────────
  event markCopyLoaned(copyId: String, borrowerId: String): Boolean
    refines library_system_requirements::LibrarySystem.requestLoan {
    pre: copyId <> null;
    pre: self.copyStatuses->exists(c | c.copyId = copyId and c.status = 'AVAILABLE');
    post: self.copyStatuses->forAll(
            c | if c.copyId = copyId then c.status = 'LOANED' and c.currentBorrower = borrowerId
                else c.status = c.status@pre and c.currentBorrower = c.currentBorrower@pre
                endif
          );
    modifies: self.copyStatuses;
  }

  event markCopyReturned(copyId: String): Boolean
    refines library_system_requirements::LibrarySystem.returnCopy {
    pre: copyId <> null;
    pre: self.copyStatuses->exists(c | c.copyId = copyId and c.status = 'LOANED');
    post: self.copyStatuses->forAll(
            c | if c.copyId = copyId then c.status = 'AVAILABLE' and c.currentBorrower = null
                else c.status = c.status@pre and c.currentBorrower = c.currentBorrower@pre
                endif
          );
    modifies: self.copyStatuses;
  }

  event markCopyReserved(copyId: String, borrowerId: String): Boolean
    refines library_system_requirements::LibrarySystem.returnCopy,
            library_system_requirements::LibrarySystem.placeReservation {
    pre: copyId <> null;
    pre: self.copyStatuses->exists(c | c.copyId = copyId and c.status = 'LOANED');
    post: self.copyStatuses->forAll(
            c | if c.copyId = copyId then c.status = 'RESERVED' and c.currentBorrower = borrowerId
                else c.status = c.status@pre and c.currentBorrower = c.currentBorrower@pre
                endif
          );
    modifies: self.copyStatuses;
  }

  event expireCopyReservation(copyId: String): Boolean
    refines library_system_requirements::LibrarySystem.expireStaleReservation {
    pre: copyId <> null;
    pre: self.copyStatuses->exists(c | c.copyId = copyId and c.status = 'RESERVED');
    post: self.copyStatuses->forAll(
            c | if c.copyId = copyId then c.status = 'AVAILABLE' and c.currentBorrower = null
                else c.status = c.status@pre and c.currentBorrower = c.currentBorrower@pre
                endif
          );
    modifies: self.copyStatuses;
  }

  // ── Check if a copy exists in the inventory ────────────────────────
  event doesCopyExist(copyId: String): Boolean {
    pre: copyId <> null;
    post: result = self.copyStatuses->exists(c | c.copyId = copyId);
    modifies: self.inventoryId;
  }

  // ── Query copy status (useful downstream) ──────────────────────────
  event getCopyStatus(copyId: String): String {
    pre: copyId <> null;
    pre: self.copyStatuses->exists(c | c.copyId = copyId);
    post: self.copyStatuses->forAll(c | c.copyId = copyId implies result = c.status);
    modifies: self.inventoryId;
  }
}


// ─── Component: BorrowerRegistry ──────────────────────────────────────
// Owns Borrower fees + blocks indebted borrowers (GOAL-2).

kind BorrowerRegistry {
  identity: registryId;
  property registryId: String;

  property borrowers: Set<Borrower>;

  invariants {
    self.registryId <> null;
    self.borrowers->forAll(b | b.outstandingFees >= 0.0);
  }

  // ── FR-1 contribution: check borrower has no outstanding fees ─────
  event verifyBorrowerEligible(borrowerId: String): Boolean
    refines library_system_requirements::LibrarySystem.requestLoan,
            library_system_formalization::LibrarySystemFormalized.enforceDebtFreeBorrowerCheck {
    pre: borrowerId <> null;
    post: result = self.borrowers->exists(b | b.borrowerId = borrowerId and b.outstandingFees = 0.0);
    modifies: self.registryId;
  }

  // ── Accrue late fee for a borrower ─────────────────────────────────
  event accrueLateFee(borrowerId: String, amount: Real): Boolean
    refines library_system_requirements::LibrarySystem.returnCopy,
            library_system_formalization::LibrarySystemFormalized.enforceLateFeeComputation {
    pre: borrowerId <> null;
    pre: amount >= 0.0;
    pre: self.borrowers->exists(b | b.borrowerId = borrowerId);
    post: self.borrowers->forAll(
            b | if b.borrowerId = borrowerId then b.outstandingFees = b.outstandingFees@pre + amount
                else b.outstandingFees = b.outstandingFees@pre
                endif
          );
    modifies: self.borrowers;
  }

  // ── Pay down outstanding fees ─────────────────────────────────────
  event payFee(borrowerId: String, amount: Real): Boolean
    refines library_system_requirements::LibrarySystem.payLateFee {
    pre: borrowerId <> null;
    pre: amount >= 0.0;
    pre: self.borrowers->exists(b | b.borrowerId = borrowerId and b.outstandingFees >= amount);
    post: self.borrowers->forAll(
            b | if b.borrowerId = borrowerId then b.outstandingFees = b.outstandingFees@pre - amount
                else b.outstandingFees = b.outstandingFees@pre
                endif
          );
    modifies: self.borrowers;
  }

  // ── Query borrower's outstanding fees ──────────────────────────────
  event getOutstandingFees(borrowerId: String): Real {
    pre: borrowerId <> null;
    pre: self.borrowers->exists(b | b.borrowerId = borrowerId);
    post: self.borrowers->forAll(b | b.borrowerId = borrowerId implies result = b.outstandingFees);
    modifies: self.registryId;
  }
}


// ─── Component: LoanLedger ────────────────────────────────────────────
// Owns Loan records, late fee computation (GOAL-4) and due-date tracking.
// NOTE: returnDate is modeled as Real (timestamp) for arithmetic, NOT String.

kind LoanLedger {
  identity: ledgerId;
  property ledgerId: String;
  property loans: Set<Loan>;
  property dailyLateFeeRate: Real;

  invariants {
    self.ledgerId <> null;
    self.dailyLateFeeRate >= 0.0;
    self.loans->forAll(l | l.startDate <> null and l.dueDate <> null and l.lateFee >= 0.0);
  }

  // ── Record a new loan ───────────────────────────────────────────────
  event recordLoan(copyId: String, borrowerId: String, loanId: String,
                   startDate: String, dueDate: String): Boolean
    refines library_system_requirements::LibrarySystem.requestLoan {
    pre: copyId <> null;
    pre: borrowerId <> null;
    pre: loanId <> null;
    pre: startDate <> null;
    pre: dueDate <> null;
    pre: not self.loans->exists(l | l.loanId = loanId);
    post: self.loans->exists(l | l.loanId = loanId and l.copy.copyId = copyId
                                  and l.borrower.borrowerId = borrowerId
                                  and l.startDate = startDate and l.dueDate = dueDate
                                  and l.lateFee = 0.0);
    modifies: self.loans;
  }

  // ── Process return: compute late fee ───────────────────────────────
  // Late fee = max(0, (returnDate - dueDate) * dailyLateFeeRate)
  // FIX: returnDate and dueDate are Real (timestamps), NOT String.
  // Avoid .toString — instead use a boolean flag 'isReturnRecorded'.
  event processReturn(copyId: String, returnDate: Real, dueDate: Real): Real
    refines library_system_requirements::LibrarySystem.returnCopy,
            library_system_formalization::LibrarySystemFormalized.enforceLateFeeComputation {
    pre: copyId <> null;
    pre: self.loans->exists(l | l.copy.copyId = copyId and l.returnDate = '');
    pre: returnDate >= 0.0;
    pre: dueDate >= 0.0;
    post: if returnDate > dueDate then
            result = (returnDate - dueDate) * self.dailyLateFeeRate
          else
            result = 0.0
          endif;
    post: self.loans->forAll(l | if l.copy.copyId = copyId then
                                  l.lateFee = result
                                 else
                                  l.lateFee = l.lateFee@pre
                                 endif);
    modifies: self.loans;
  }

  // ── Query if a copy is currently on loan ────────────────────────────
  event isCopyOnLoan(copyId: String): Boolean {
    pre: copyId <> null;
    post: result = self.loans->exists(l | l.copy.copyId = copyId and l.returnDate = '');
    modifies: self.ledgerId;
  }

  // ── Get the borrower for an on-loan copy ────────────────────────────
  event getBorrowerOfCopy(copyId: String): String {
    pre: copyId <> null;
    pre: self.loans->exists(l | l.copy.copyId = copyId and l.returnDate = '');
    post: self.loans->forAll(l | l.copy.copyId = copyId and l.returnDate = ''
                                implies result = l.borrower.borrowerId);
    modifies: self.ledgerId;
  }
}


// ─── Component: ReservationManager ────────────────────────────────────
// Owns Reservation lifecycle + expiry (GOAL-3).
// When a copy returns and there is a reservation, it must be served.

kind ReservationManager {
  identity: reservationManagerId;
  property reservationManagerId: String;
  property reservations: Set<Reservation>;
  property reservationExpiryDays: Integer;

  invariants {
    self.reservationManagerId <> null;
    self.reservationExpiryDays = 7;
    self.reservations->forAll(r | r.isActive implies r.expiresOn <> null);
  }

  // ── Place a new reservation (copy is currently LOANED) ─────────────
  event placeReservation(copyId: String, borrowerId: String,
                          placedDate: String, reservationId: String): Boolean
    refines library_system_requirements::LibrarySystem.placeReservation {
    pre: copyId <> null;
    pre: borrowerId <> null;
    pre: placedDate <> null;
    pre: reservationId <> null;
    pre: not self.reservations->exists(r | r.reservationId = reservationId);
    // Expiry = placedDate + 7 days (simplified as string concatenation for now)
    post: self.reservations->exists(r | r.reservationId = reservationId
                                        and r.copy.copyId = copyId
                                        and r.borrower.borrowerId = borrowerId
                                        and r.placedDate = placedDate
                                        and r.isActive = true);
    modifies: self.reservations;
  }

  // ── Check if there is a pending reservation for a copy (on return) ──
  event hasPendingReservation(copyId: String): Boolean
    refines library_system_requirements::LibrarySystem.returnCopy {
    pre: copyId <> null;
    post: result = self.reservations->exists(r | r.copy.copyId = copyId
                                                 and r.isActive = true);
    modifies: self.reservationManagerId;
  }

  // ── Get the top borrower from pending reservations for a copy ─────
  event getNextReservationBorrower(copyId: String): String {
    pre: copyId <> null;
    pre: self.reservations->exists(r | r.copy.copyId = copyId and r.isActive = true);
    // In a real system, we'd pick the earliest; here we just return the first.
    post: self.reservations->forAll(r | r.copy.copyId = copyId and r.isActive = true
                                      implies result = r.borrower.borrowerId);
    modifies: self.reservationManagerId;
  }

  // ── Expire a stale reservation (GOAL-3) ────────────────────────────
  event expireOldReservation(reservationId: String): Boolean
    refines library_system_requirements::LibrarySystem.expireStaleReservation,
            library_system_formalization::LibrarySystemFormalized.enforceReservationExpiry {
    pre: reservationId <> null;
    pre: self.reservations->exists(r | r.reservationId = reservationId and r.isActive = true);
    post: self.reservations->forAll(r | if r.reservationId = reservationId then r.isActive = false
                                        else r.isActive = r.isActive@pre endif);
    modifies: self.reservations;
  }
}


// ─── Component: AuditLogger (documentary) ─────────────────────────────
// Records all state transitions for audit compliance (FINANCIAL).
// This component does not modify business state; it only records.

kind AuditLogger {
  identity: loggerId;
  property loggerId: String;

  // Simplified: we store a Set of Strings recording events.
  // In practice, this would be an append-only log.
  property auditLog: Set<String>;

  invariants {
    self.loggerId <> null;
  }

  event logTransition(entityId: String, fromState: String, toState: String,
                      timestamp: String): Boolean
    refines library_system_formalization::LibrarySystemFormalized.logCopyStateTransition {
    pre: entityId <> null;
    pre: fromState <> null;
    pre: toState <> null;
    pre: fromState <> toState;
    post: self.auditLog->size() = self.auditLog@pre->size() + 1;
    post: true;  // simplified; real log appending is post: self.auditLog->includes(logEntry)
    modifies: self.auditLog;
  }
}


// ─── Relator: LoanServiceInterface (Coordinates loan lifecycle) ─────
// Mediates between CopyInventory and LoanLedger.

role InventoryEndpoint mediated-by LoanServiceInterface of CopyInventory {
  property inventoryId: String;
}
role LoanEndpoint mediated-by LoanServiceInterface of LoanLedger {
  property ledgerId: String;
}

relator LoanServiceInterface mediates (InventoryEndpoint, LoanEndpoint) {
  identity: interfaceId;
  property interfaceId: String;

  // Invariant: the loan service always keeps inventory and loan state
  // synchronised.
  invariants {
    self.interfaceId <> null;
  }
}


// ─── Relator: BorrowerValidationInterface ────────────────────────────
// Mediates between BorrowerRegistry and the loan flow.

role RegistryEndpoint mediated-by BorrowerValidationInterface of BorrowerRegistry {
  property registryId: String;
}
role LoanFlowEndpoint mediated-by BorrowerValidationInterface of LoanLedger {
  property ledgerId: String;
}

relator BorrowerValidationInterface mediates (RegistryEndpoint, LoanFlowEndpoint) {
  identity: interfaceId2;
  property interfaceId2: String;

  invariants {
    self.interfaceId2 <> null;
  }
}


// ─── Relator: ReservationCoordinator ─────────────────────────────────
// Mediates between CopyInventory and ReservationManager.

role InventoryEndpoint2 mediated-by ReservationCoordinator of CopyInventory {
  property inventoryId: String;
}
role ReservationEndpoint mediated-by ReservationCoordinator of ReservationManager {
  property reservationManagerId: String;
}

relator ReservationCoordinator mediates (InventoryEndpoint2, ReservationEndpoint) {
  identity: interfaceId3;
  property interfaceId3: String;

  invariants {
    self.interfaceId3 <> null;
  }
}


// =====================================================================
// Happening: Full Loan Flow (cross-component coordination)
// =====================================================================
// FIX S2: Added 'identity: flowId;'

happening FullLoanFlow {
  identity: flowId;
  property flowId: String;
  property triggeredBy: String;
  property borrowerId: String;
  property copyId: String;
  property loanGranted: Boolean;

  invariants {
    self.flowId <> null;
    self.triggeredBy <> null;
  }

  // The flow is a composition of component events:
  //   1. LoanLedger.isCopyOnLoan
  //   2. BorrowerRegistry.verifyBorrowerEligible
  //   3. CopyInventory.verifyCopyAvailable
  //   4. LoanLedger.recordLoan
  //   5. CopyInventory.markCopyLoaned
  //   6. AuditLogger.logTransition (AVAILABLE -> LOANED)
}


// ─── Happening: Return Flow (cross-component coordination) ───────────
// FIX S2: Added 'identity: flowId2;'

happening ReturnFlow {
  identity: flowId2;
  property flowId2: String;
  property copyId: String;
  property returnDate: Real;
  property lateFeeAccrued: Real;
  property hasReservation: Boolean;

  invariants {
    self.flowId2 <> null;
    self.copyId <> null;
  }

  // The flow:
  //   1. LoanLedger.processReturn (compute late fee)
  //   2. BorrowerRegistry.accrueLateFee
  //   3. ReservationManager.hasPendingReservation
  //   4. If reservation exists:
  //        - ReservationManager.getNextReservationBorrower
  //        - CopyInventory.markCopyReserved
  //      Else:
  //        - CopyInventory.markCopyReturned
  //   5. AuditLogger.logTransition (LOANED -> AVAILABLE or LOANED -> RESERVED)
}
