{
  "name": "online-banking-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TanStack Start fullstack demo of the ontodls-verified online_banking domain. Runtime invariants enforced via the auto-generated validate*() functions from examples/online_banking/dist/design.ts.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"tsx scripts/dev.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx scripts/dev.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "setup": "npm install && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.95.0",
    "@tanstack/react-query": "^5.62.0",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tanstack/router-vite-plugin": "^1.95.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
