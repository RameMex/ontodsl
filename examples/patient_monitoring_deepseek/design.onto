schema "onto/0.1";
namespace patient_monitoring_design;
import "./discovery.onto";
import "./requirements.onto";
import "./formalization.onto";

// =========================================================================
// Design Stage — Bedside Vital-Signs Monitor
//
// Decomposition into four sibling components:
//   1. EcgSensor — owns the physical signal acquisition state
//   2. HeartRateProcessor — owns plausibility checking + rejection counting
//   3. AlarmManager — owns alarm state, silencing, auto-rearm
//   4. DisplayRenderer — owns display state (current HR, alarm indicators)
//
// Interfaces (relators) connect components to each other and to the
// external actors (Clinician, Patient) via roles.
//
// Each component event refines exactly one parent event from the
// requirements stage, so the inter-stage verifier can audit
// modifies-closure and property correspondence (Obligation 4).
// =========================================================================

// ─── Roles (Endpoints of interfaces) ─────────────────────────────────────

role EcgSensorEndpoint mediated-by SensorDataChannel of EcgSensor {
  property sensorId: String;
  property sensorConnected: Boolean;
  property lastSignalTimestamp: Real;
  property currentReadingValue: Real;
  property readingTimestamp: Real;
}

role HeartRateProcessorEndpoint mediated-by SensorDataChannel of HeartRateProcessor {
  property processorId: String;
  property implausibleThresholdLower: Real;
  property implausibleThresholdUpper: Real;
  property rejectionCount: Integer;
  property heartRatePlausible: Boolean;
}

role AlarmManagerEndpoint mediated-by AlarmInterface of AlarmManager {
  property managerId: String;
  property alarmActive: Boolean;
  property alarmSilenced: Boolean;
  property alarmSilenceTimestamp: Real;
  property alarmType: String;
  property maxAlarmLatencyMs: Real;
  property silenceAutoRearmMs: Real;
}

role DisplayEndpoint mediated-by DisplayInterface of DisplayRenderer {
  property displayId: String;
  property displayedHeartRate: Real;
  property displayedAlarmActive: Boolean;
  property displayedAlarmType: String;
}

// ─── Interfaces (Relators) ──────────────────────────────────────────────

relator SensorDataChannel mediates (EcgSensorEndpoint, HeartRateProcessorEndpoint) {
  identity: channelId;
  property channelId: String;
  property maxLatencyMs: Real;
  property dataFormat: String;
  invariants {
    self.channelId <> null;
    self.maxLatencyMs <= 10.0;
    self.dataFormat = 'bpm_raw';
  }
}

relator AlarmInterface mediates (HeartRateProcessorEndpoint, AlarmManagerEndpoint) {
  identity: ifaceId;
  property ifaceId: String;
  property thresholdCrossSignal: Boolean;
  property crossingDirection: String;
  property crossingValue: Real;
  property crossingTimestamp: Real;
  invariants {
    self.ifaceId <> null;
  }
}

relator DisplayInterface mediates (AlarmManagerEndpoint, DisplayEndpoint) {
  identity: displayIfaceId;
  property displayIfaceId: String;
  property updateRateHz: Real;
  property maxLatencyMs: Real;
  invariants {
    self.displayIfaceId <> null;
    self.updateRateHz >= 1.0;
    self.maxLatencyMs <= 100.0;
  }
}

relator ClinicianAlarmInterface mediates (Clinician, AlarmManagerEndpoint) {
  identity: clinicianIfaceId;
  property clinicianIfaceId: String;
  property silenceButtonAvailable: Boolean;
  property silenceDebounceMs: Real;
  invariants {
    self.clinicianIfaceId <> null;
    self.silenceButtonAvailable = true;
    self.silenceDebounceMs <= 50.0;
  }
}

// ─── Component 1: ECG Sensor ─────────────────────────────────────────────

kind EcgSensor {
  identity: sensorId;
  property sensorId: String;
  property sensorConnected: Boolean;
  property lastSignalTimestamp: Real;
  property currentReadingValue: Real;
  property readingTimestamp: Real;
  property signalLossTimerMs: Real;

  invariants {
    self.sensorId <> null;
    self.lastSignalTimestamp >= 0.0;
    self.readingTimestamp >= 0.0;
    if self.sensorConnected then self.signalLossTimerMs <= 5000.0 else true endif;
  }

  event acquireReading(value: Real, timestamp: Real)
    refines patient_monitoring_requirements::BedsideMonitorSystemRequirements.deliverHeartRateReading {
    pre: timestamp >= 0.0;
    pre: value >= 0.0;
    pre: self.sensorConnected = true;
    post: self.currentReadingValue = value;
    post: self.readingTimestamp = timestamp;
    post: self.lastSignalTimestamp = timestamp;
    post: self.signalLossTimerMs = 0.0;
    modifies: self.currentReadingValue, self.readingTimestamp, self.lastSignalTimestamp, self.signalLossTimerMs;
  }

  event advanceSignalLossTimer(elapsedMs: Real)
    refines patient_monitoring_requirements::BedsideMonitorSystemRequirements.detectSensorDisconnect {
    pre: self.sensorConnected = true;
    pre: elapsedMs > 0.0;
    post: self.signalLossTimerMs = self.signalLossTimerMs@pre + elapsedMs;
    post: if self.signalLossTimerMs > 5000.0 then
            self.sensorConnected = false
          else
            self.sensorConnected = true
          endif;
    modifies: self.signalLossTimerMs, self.sensorConnected;
  }

  event restoreConnection(value: Real, timestamp: Real)
    refines patient_monitoring_requirements::BedsideMonitorSystemRequirements.restoreSensorConnection {
    pre: self.sensorConnected = false;
    pre: timestamp >= 0.0;
    post: self.sensorConnected = true;
    post: self.currentReadingValue = value;
    post: self.readingTimestamp = timestamp;
    post: self.lastSignalTimestamp = timestamp;
    post: self.signalLossTimerMs = 0.0;
    modifies: self.sensorConnected, self.currentReadingValue, self.readingTimestamp, self.lastSignalTimestamp, self.signalLossTimerMs;
  }

  event resetSensor() {
    pre: true;
    post: self.sensorConnected = true;
    post: self.signalLossTimerMs = 0.0;
    post: self.lastSignalTimestamp = 0.0;
    post: self.currentReadingValue = 0.0;
    post: self.readingTimestamp = 0.0;
    modifies: self.sensorConnected, self.signalLossTimerMs, self.lastSignalTimestamp, self.currentReadingValue, self.readingTimestamp;
  }
}

// ─── Component 2: Heart Rate Processor ───────────────────────────────────

kind HeartRateProcessor {
  identity: processorId;
  property processorId: String;
  property implausibleThresholdLower: Real;
  property implausibleThresholdUpper: Real;
  property rejectionCount: Integer;
  property heartRatePlausible: Boolean;
  property lastAcceptedHeartRate: Real;
  property lastProcessedTimestamp: Real;

  invariants {
    self.processorId <> null;
    self.implausibleThresholdLower >= 0.0;
    self.implausibleThresholdUpper > self.implausibleThresholdLower;
    self.rejectionCount >= 0;
    self.lastAcceptedHeartRate >= 0.0;
    self.lastProcessedTimestamp >= 0.0;
  }

  event processReading(rawValue: Real, readingTimestamp: Real)
    refines patient_monitoring_requirements::BedsideMonitorSystemRequirements.deliverHeartRateReading {
    pre: readingTimestamp >= 0.0;
    pre: rawValue >= 0.0;
    post: if rawValue >= self.implausibleThresholdLower and rawValue <= self.implausibleThresholdUpper then
            self.lastAcceptedHeartRate = rawValue and
            self.heartRatePlausible = true and
            self.rejectionCount = self.rejectionCount@pre and
            self.lastProcessedTimestamp = readingTimestamp
          else
            self.heartRatePlausible = false and
            self.rejectionCount = self.rejectionCount@pre + 1 and
            self.lastAcceptedHeartRate = self.lastAcceptedHeartRate@pre and
            self.lastProcessedTimestamp = self.lastProcessedTimestamp@pre
          endif;
    modifies: self.lastAcceptedHeartRate, self.heartRatePlausible, self.rejectionCount, self.lastProcessedTimestamp;
  }

  event configureBounds(lower: Real, upper: Real)
    refines patient_monitoring_formalization::BedsideMonitorSystemFormalized.formalConfigurePlausibilityBounds {
    pre: lower >= 0.0;
    pre: upper > lower;
    pre: lower <= 20.0;
    pre: upper >= 250.0;
    post: self.implausibleThresholdLower = lower;
    post: self.implausibleThresholdUpper = upper;
    modifies: self.implausibleThresholdLower, self.implausibleThresholdUpper;
  }

  event rejectImplausibleReading(rawValue: Real, timestamp: Real)
    refines patient_monitoring_formalization::BedsideMonitorSystemFormalized.formalRejectImplausibleReading {
    pre: timestamp >= 0.0;
    pre: rawValue < self.implausibleThresholdLower or rawValue > self.implausibleThresholdUpper;
    post: self.heartRatePlausible = false;
    post: self.rejectionCount = self.rejectionCount@pre + 1;
    post: self.lastAcceptedHeartRate = self.lastAcceptedHeartRate@pre;
    modifies: self.heartRatePlausible, self.rejectionCount;
  }

  event resetProcessor() {
    pre: true;
    post: self.rejectionCount = 0;
    post: self.heartRatePlausible = false;
    post: self.lastAcceptedHeartRate = 0.0;
    post: self.lastProcessedTimestamp = 0.0;
    modifies: self.rejectionCount, self.heartRatePlausible, self.lastAcceptedHeartRate, self.lastProcessedTimestamp;
  }
}

// ─── Component 3: Alarm Manager ──────────────────────────────────────────

kind AlarmManager {
  identity: managerId;
  property managerId: String;
  property alarmActive: Boolean;
  property alarmSilenced: Boolean;
  property alarmSilenceTimestamp: Real;
  property alarmType: String;
  property maxAlarmLatencyMs: Real;
  property silenceAutoRearmMs: Real;
  property alarmTriggeredTimestamp: Real;

  invariants {
    self.managerId <> null;
    self.maxAlarmLatencyMs > 0.0;
    self.silenceAutoRearmMs > 0.0;
    self.alarmSilenceTimestamp >= 0.0;
    self.alarmTriggeredTimestamp >= 0.0;
  }

  event raiseThresholdAlarm(vitalType: String, actualValue: Real, crossTimestamp: Real)
    refines patient_monitoring_requirements::BedsideMonitorSystemRequirements.raiseThresholdAlarm {
    pre: crossTimestamp >= 0.0;
    pre: self.alarmActive = false;
    pre: not self.alarmSilenced;
    post: self.alarmActive = true;
    post: self.alarmSilenced = false;
    post: self.alarmType = vitalType;
    post: self.alarmTriggeredTimestamp = crossTimestamp;
    modifies: self.alarmActive, self.alarmSilenced, self.alarmType, self.alarmTriggeredTimestamp;
  }

  event raiseDisconnectAlarm(detectedAt: Real)
    refines patient_monitoring_requirements::BedsideMonitorSystemRequirements.detectSensorDisconnect {
    pre: detectedAt >= 0.0;
    pre: self.alarmActive = false;
    post: self.alarmActive = true;
    post: self.alarmSilenced = false;
    post: self.alarmType = 'disconnect';
    post: self.alarmTriggeredTimestamp = detectedAt;
    modifies: self.alarmActive, self.alarmSilenced, self.alarmType, self.alarmTriggeredTimestamp;
  }

  event silenceAlarm(silenceTimestamp: Real)
    refines patient_monitoring_requirements::BedsideMonitorSystemRequirements.silenceAlarm {
    pre: self.alarmActive = true;
    pre: not self.alarmSilenced;
    pre: silenceTimestamp >= self.alarmTriggeredTimestamp;
    post: self.alarmSilenced = true;
    post: self.alarmSilenceTimestamp = silenceTimestamp;
    post: self.alarmActive = true;
    post: self.alarmType = self.alarmType@pre;
    modifies: self.alarmSilenced, self.alarmSilenceTimestamp;
  }

  event autoRearmAlarm(rearmTimestamp: Real)
    refines patient_monitoring_requirements::BedsideMonitorSystemRequirements.autoRearmAlarm {
    pre: self.alarmSilenced = true;
    pre: rearmTimestamp - self.alarmSilenceTimestamp >= self.silenceAutoRearmMs;
    post: self.alarmSilenced = false;
    post: self.alarmActive = true;
    post: self.alarmSilenceTimestamp = self.alarmSilenceTimestamp@pre;
    modifies: self.alarmSilenced;
  }

  event clearAlarm()
    refines patient_monitoring_requirements::BedsideMonitorSystemRequirements.clearAlarm {
    pre: self.alarmActive = true;
    post: self.alarmActive = false;
    post: self.alarmSilenced = false;
    post: self.alarmType = 'none';
    post: self.alarmTriggeredTimestamp = 0.0;
    modifies: self.alarmActive, self.alarmSilenced, self.alarmType, self.alarmTriggeredTimestamp;
  }

  event configureAlarmParams(latencyMs: Real, rearmMs: Real)
    refines patient_monitoring_formalization::BedsideMonitorSystemFormalized.formalConfigurePlausibilityBounds {
    pre: latencyMs > 0.0;
    pre: rearmMs > 0.0;
    pre: latencyMs <= 2000.0;
    pre: rearmMs <= 120000.0;
    post: self.maxAlarmLatencyMs = latencyMs;
    post: self.silenceAutoRearmMs = rearmMs;
    modifies: self.maxAlarmLatencyMs, self.silenceAutoRearmMs;
  }

  event resetAlarmManager() {
    pre: true;
    post: self.alarmActive = false;
    post: self.alarmSilenced = false;
    post: self.alarmType = 'none';
    post: self.alarmSilenceTimestamp = 0.0;
    post: self.alarmTriggeredTimestamp = 0.0;
    modifies: self.alarmActive, self.alarmSilenced, self.alarmType, self.alarmSilenceTimestamp, self.alarmTriggeredTimestamp;
  }
}

// ─── Component 4: Display Renderer ───────────────────────────────────────

kind DisplayRenderer {
  identity: displayId;
  property displayId: String;
  property displayedHeartRate: Real;
  property displayedAlarmActive: Boolean;
  property displayedAlarmType: String;
  property lastUpdateTimestamp: Real;

  invariants {
    self.displayId <> null;
    self.lastUpdateTimestamp >= 0.0;
  }

  event updateHeartRateDisplay(newHeartRate: Real, timestamp: Real) {
    pre: timestamp >= 0.0;
    pre: newHeartRate >= 0.0;
    post: self.displayedHeartRate = newHeartRate;
    post: self.lastUpdateTimestamp = timestamp;
    modifies: self.displayedHeartRate, self.lastUpdateTimestamp;
  }

  event updateAlarmDisplay(newAlarmActive: Boolean, newAlarmType: String, timestamp: Real) {
    pre: timestamp >= 0.0;
    post: self.displayedAlarmActive = newAlarmActive;
    post: self.displayedAlarmType = newAlarmType;
    post: self.lastUpdateTimestamp = timestamp;
    modifies: self.displayedAlarmActive, self.displayedAlarmType, self.lastUpdateTimestamp;
  }

  event resetDisplay() {
    pre: true;
    post: self.displayedHeartRate = 0.0;
    post: self.displayedAlarmActive = false;
    post: self.displayedAlarmType = 'none';
    post: self.lastUpdateTimestamp = 0.0;
    modifies: self.displayedHeartRate, self.displayedAlarmActive, self.displayedAlarmType, self.lastUpdateTimestamp;
  }
}

// ─── Data Flows (Happenings) ─────────────────────────────────────────────
// NOTE: All happenings below are RENAMED to avoid collision with imported
// SensorDisconnectFlow from discovery.onto. They also declare identity per S2.

happening DesignNormalReadingFlow {
  identity: flowId;
  property flowId: String;
  property triggeredBy: String;
  property outcome: String;
  invariants {
    self.flowId <> null;
  }
}

happening DesignThresholdAlarmFlow {
  identity: flowId;
  property flowId: String;
  property triggeredBy: String;
  property outcome: String;
  invariants {
    self.flowId <> null;
  }
}

happening DesignSensorDisconnectFlow {
  identity: flowId;
  property flowId: String;
  property triggeredBy: String;
  property outcome: String;
  invariants {
    self.flowId <> null;
  }
}

happening DesignAlarmSilenceAutoRearmFlow {
  identity: flowId;
  property flowId: String;
  property triggeredBy: String;
  property outcome: String;
  invariants {
    self.flowId <> null;
  }
}

// ─── Explicit Relations ─────────────────────────────────────────────────

relation ecgSensorMed: <<mediation>> from SensorDataChannel [1] to EcgSensorEndpoint [1];
relation hrProcMed: <<mediation>> from SensorDataChannel [1] to HeartRateProcessorEndpoint [1];
relation alarmIfaceMed: <<mediation>> from AlarmInterface [1] to HeartRateProcessorEndpoint [1];
relation alarmMgrMed: <<mediation>> from AlarmInterface [1] to AlarmManagerEndpoint [1];
relation displayIfaceMed: <<mediation>> from DisplayInterface [1] to AlarmManagerEndpoint [1];
relation displayRendererMed: <<mediation>> from DisplayInterface [1] to DisplayEndpoint [1];
relation clinicianIfaceMed: <<mediation>> from ClinicianAlarmInterface [1] to AlarmManagerEndpoint [1];
