schema "onto/0.1";
namespace traffic_light_design;
import "./discovery.onto";
import "./requirements.onto";
import "./formalization.onto";

// =====================================================================
// Design Stage — Traffic Light Controller
//
// Decomposition of TrafficLightSystem into components:
//   1. PhaseManager     — owns phase sequencing and timing
//   2. SafetyMonitor    — owns preemption detection and all-red enforcement
//   3. PedestrianModule — owns pedestrian request and walk signal logic
//   4. TimerService     — provides elapsed-time ticks to all components
//
// Interfaces (relators) between components:
//   PhaseTimerChannel    — PhaseManager ↔ TimerService (reading elapsed)
//   PedestrianTimerChannel — PedestrianModule ↔ TimerService
//   SafetyTimeoutChannel — SafetyMonitor ↔ TimerService (reading elapsed)
//
// Happenings capture end-to-end cross-component data flows.
// =====================================================================

// ─── Component: PhaseManager ─────────────────────────────────────────
// OWNED PROPERTIES: activePhase, greenApproaches, phases, isOperating
// (delegated from system kind).
kind PhaseManager {
  identity: managerId;
  property managerId: String;
  property activePhase: Phase;
  property greenApproaches: Set<Approach>;
  property phases: Set<Phase>;
  property isOperating: Boolean;
  property allRedDwellActive: Boolean;

  invariants {
    self.managerId <> null;
    self.greenApproaches->forAll(a |
      self.greenApproaches->forAll(b |
        a = b or a.direction <> b.direction));
    self.activePhase <> null implies
      self.greenApproaches = self.activePhase.greenApproaches;
  }

  // Refines TrafficLightSystem.startNormalPhase
  event startNormalPhase(p: Phase)
    refines traffic_light_requirements::TrafficLightSystem.startNormalPhase {
    pre: p <> null;
    pre: self.isOperating;
    pre: not self.allRedDwellActive;
    pre: p.greenApproaches->forAll(a1 |
           p.greenApproaches->forAll(a2 |
             a1 = a2 or a1.direction <> a2.direction));
    post: self.activePhase = p;
    post: self.greenApproaches = p.greenApproaches;
    post: self.allRedDwellActive = false;
    modifies: self.activePhase, self.greenApproaches, self.allRedDwellActive;
  }

  // Refines TrafficLightSystem.transitionToYellow
  event transitionToYellow()
    refines traffic_light_requirements::TrafficLightSystem.transitionToYellow {
    pre: self.activePhase <> null;
    pre: self.isOperating;
    pre: self.greenApproaches->notEmpty();
    post: self.greenApproaches->isEmpty();
    modifies: self.greenApproaches;
  }

  // Refines TrafficLightSystem.transitionToRed
  event transitionToRed()
    refines traffic_light_requirements::TrafficLightSystem.transitionToRed {
    pre: self.greenApproaches->isEmpty();
    pre: self.isOperating;
    post: self.greenApproaches->isEmpty();  // already empty
    post: self.allRedDwellActive = true;
    modifies: self.allRedDwellActive;
  }

  // All-red dwell completed — ready for next phase
  event completeAllRedDwell() {
    pre: self.allRedDwellActive;
    post: self.allRedDwellActive = false;
    modifies: self.allRedDwellActive;
  }

  // Emergency entered — clear all green and set all-red
  event emergencyAllRed()
    refines traffic_light_requirements::TrafficLightSystem.emergencyPreemption {
    pre: self.isOperating;
    pre: not self.allRedDwellActive;      // not already in all-red
    post: self.greenApproaches->isEmpty();
    post: self.allRedDwellActive = true;
    post: self.activePhase = null;
    modifies: self.greenApproaches, self.allRedDwellActive, self.activePhase;
  }

  event startSystem()
    refines traffic_light_requirements::TrafficLightSystem.startSystem {
    pre: not self.isOperating;
    post: self.isOperating = true;
    post: self.activePhase = null;
    post: self.greenApproaches->isEmpty();
    post: self.allRedDwellActive = false;
    modifies: self.isOperating, self.activePhase,
              self.greenApproaches, self.allRedDwellActive;
  }

  event stopSystem()
    refines traffic_light_requirements::TrafficLightSystem.stopSystem {
    pre: self.isOperating;
    post: self.isOperating = false;
    post: self.greenApproaches->isEmpty();
    modifies: self.isOperating, self.greenApproaches;
  }
}

// ─── Component: SafetyMonitor ────────────────────────────────────────
// OWNED PROPERTIES: preemptionActive, allRedActive, preemptionTimerElapsed,
// preemptionResponseTimeSeconds.
kind SafetyMonitor {
  identity: monitorId;
  property monitorId: String;
  property preemptionActive: Boolean;
  property allRedActive: Boolean;
  property preemptionTimerElapsed: Real;
  property preemptionResponseTimeSeconds: Real;

  invariants {
    self.monitorId <> null;
    self.preemptionResponseTimeSeconds <= 1.0;
    self.preemptionTimerElapsed >= 0.0;
    self.preemptionActive implies self.allRedActive;
  }

  // Refines TrafficLightSystem.emergencyPreemption
  event emergencyPreemption()
    refines traffic_light_requirements::TrafficLightSystem.emergencyPreemption {
    pre: not self.preemptionActive;
    post: self.preemptionActive = true;
    post: self.allRedActive = true;
    post: self.preemptionTimerElapsed = 0.0;
    modifies: self.preemptionActive, self.allRedActive,
              self.preemptionTimerElapsed;
  }

  // Refines TrafficLightSystem.clearPreemption
  event clearPreemption()
    refines traffic_light_requirements::TrafficLightSystem.clearPreemption {
    pre: self.preemptionActive;
    pre: self.preemptionTimerElapsed >= self.preemptionResponseTimeSeconds;
    post: self.preemptionActive = false;
    post: self.allRedActive = false;
    post: self.preemptionTimerElapsed = 0.0;
    modifies: self.preemptionActive, self.allRedActive,
              self.preemptionTimerElapsed;
  }

  // Called by TimerService tick — advance timer
  event advancePreemptionTimer(dt: Real) {
    pre: self.preemptionActive;
    pre: dt >= 0.0;
    post: self.preemptionTimerElapsed = self.preemptionTimerElapsed@pre + dt;
    modifies: self.preemptionTimerElapsed;
  }

  event startSystem()
    refines traffic_light_requirements::TrafficLightSystem.startSystem {
    pre: not self.preemptionActive;
    post: self.preemptionActive = false;
    post: self.allRedActive = false;
    post: self.preemptionTimerElapsed = 0.0;
    modifies: self.preemptionActive, self.allRedActive,
              self.preemptionTimerElapsed;
  }

  event stopSystem()
    refines traffic_light_requirements::TrafficLightSystem.stopSystem {
    pre: not self.preemptionActive;
    post: self.preemptionActive = false;
    post: self.allRedActive = false;
    post: self.preemptionTimerElapsed = 0.0;
    modifies: self.preemptionActive, self.allRedActive,
              self.preemptionTimerElapsed;
  }
}

// ─── Component: PedestrianModule ─────────────────────────────────────
// OWNED PROPERTIES: pedestrianRequested, pedestrianRequestPending,
// walkSignalActive.
kind PedestrianModule {
  identity: moduleId;
  property moduleId: String;
  property pedestrianRequested: Boolean;
  property pedestrianRequestPending: Boolean;
  property walkSignalActive: Boolean;

  invariants {
    self.moduleId <> null;
    self.pedestrianRequested implies self.pedestrianRequestPending;
    self.walkSignalActive implies not self.pedestrianRequestPending;
  }

  // Refines TrafficLightSystem.registerPedestrianRequest
  event registerPedestrianRequest()
    refines traffic_light_requirements::TrafficLightSystem.registerPedestrianRequest {
    pre: not self.pedestrianRequested;
    pre: not self.pedestrianRequestPending;
    post: self.pedestrianRequested = true;
    post: self.pedestrianRequestPending = true;
    modifies: self.pedestrianRequested, self.pedestrianRequestPending;
  }

  // Refines TrafficLightSystem.grantWalk
  event grantWalk()
    refines traffic_light_requirements::TrafficLightSystem.grantWalk {
    pre: self.pedestrianRequested;
    pre: self.pedestrianRequestPending;
    post: self.pedestrianRequested = false;
    post: self.pedestrianRequestPending = false;
    post: self.walkSignalActive = true;
    modifies: self.pedestrianRequested, self.pedestrianRequestPending,
              self.walkSignalActive;
  }

  // Refines TrafficLightSystem.clearWalk
  event clearWalk()
    refines traffic_light_requirements::TrafficLightSystem.clearWalk {
    pre: self.walkSignalActive;
    post: self.walkSignalActive = false;
    modifies: self.walkSignalActive;
  }

  event startSystem()
    refines traffic_light_requirements::TrafficLightSystem.startSystem {
    pre: not self.pedestrianRequested;
    post: self.pedestrianRequested = false;
    post: self.pedestrianRequestPending = false;
    post: self.walkSignalActive = false;
    modifies: self.pedestrianRequested, self.pedestrianRequestPending,
              self.walkSignalActive;
  }

  event stopSystem()
    refines traffic_light_requirements::TrafficLightSystem.stopSystem {
    pre: not self.walkSignalActive;
    post: self.walkSignalActive = false;
    modifies: self.walkSignalActive;
  }
}

// ─── Component: TimerService ─────────────────────────────────────────
// OWNED PROPERTIES: yellowTimerElapsed, elapsedTime.
// Fires ticks to all components.
kind TimerService {
  identity: timerId;
  property timerId: String;
  property yellowTimerElapsed: Real;
  property elapsedTime: Real;
  property yellowIntervalSeconds: Real;

  invariants {
    self.timerId <> null;
    self.yellowIntervalSeconds >= 3.0;
    self.yellowTimerElapsed >= 0.0;
    self.elapsedTime >= 0.0;
  }

  // Refines TrafficLightSystem.tickElapsedTimers
  event tickElapsedTimers(dt: Real)
    refines traffic_light_requirements::TrafficLightSystem.tickElapsedTimers {
    pre: dt >= 0.0;
    post: self.yellowTimerElapsed = self.yellowTimerElapsed@pre + dt;
    post: self.elapsedTime = self.elapsedTime@pre + dt;
    modifies: self.yellowTimerElapsed, self.elapsedTime;
  }

  // Reset yellow timer when transitioning to yellow
  event resetYellowTimer()
    refines traffic_light_requirements::TrafficLightSystem.transitionToYellow {
    pre: self.yellowTimerElapsed >= 0.0;
    post: self.yellowTimerElapsed = 0.0;
    modifies: self.yellowTimerElapsed;
  }

  // Reset yellow timer when transitioning to red
  event resetYellowTimerForRed()
    refines traffic_light_requirements::TrafficLightSystem.transitionToRed {
    pre: self.yellowTimerElapsed >= self.yellowIntervalSeconds;
    post: self.yellowTimerElapsed = 0.0;
    modifies: self.yellowTimerElapsed;
  }

  event startSystem()
    refines traffic_light_requirements::TrafficLightSystem.startSystem {
    pre: self.yellowTimerElapsed >= 0.0;
    post: self.yellowTimerElapsed = 0.0;
    post: self.elapsedTime = 0.0;
    modifies: self.yellowTimerElapsed, self.elapsedTime;
  }

  event stopSystem()
    refines traffic_light_requirements::TrafficLightSystem.stopSystem {
    post: self.yellowTimerElapsed = 0.0;
    modifies: self.yellowTimerElapsed;
  }
}

// ─── Roles (one per component endpoint) ──────────────────────────────
role PhaseManagerRole mediated-by PhaseTimerChannel of PhaseManager {
  property managerId: String;
  property isOperating: Boolean;
  property yellowTimerElapsed: Real;
}

role TimerServiceRole mediated-by PhaseTimerChannel of TimerService {
  property timerId: String;
  property yellowTimerElapsed: Real;
  property elapsedTime: Real;
}

role PedestrianModuleRole mediated-by PedestrianTimerChannel of PedestrianModule {
  property moduleId: String;
  property pedestrianRequestPending: Boolean;
}

role PedestrianTimerServiceRole mediated-by PedestrianTimerChannel of TimerService {
  property timerId: String;
  property yellowTimerElapsed: Real;
}

role SafetyMonitorTimerRole mediated-by SafetyTimeoutChannel of SafetyMonitor {
  property monitorId: String;
  property preemptionActive: Boolean;
  property preemptionTimerElapsed: Real;
}

role SafetyTimerServiceRole mediated-by SafetyTimeoutChannel of TimerService {
  property timerId: String;
  property elapsedTime: Real;
}

// ─── Relators (interfaces between components) ───────────────────────
relator PhaseTimerChannel mediates (PhaseManagerRole, TimerServiceRole) {
  identity: channelId;
  property channelId: String;
  property lastTickTimestamp: Real;
  property managerId: String;
  property timerId: String;

  invariants {
    self.channelId <> null;
    self.managerId <> null;
    self.timerId <> null;
    self.lastTickTimestamp >= 0.0;
  }

  // Propagate tick from TimerService to PhaseManager
  event propagateTick(dt: Real) {
    pre: dt >= 0.0;
    post: self.lastTickTimestamp = self.lastTickTimestamp@pre + dt;
    modifies: self.lastTickTimestamp;
  }
}

relator PedestrianTimerChannel mediates (PedestrianModuleRole, PedestrianTimerServiceRole) {
  identity: channelId;
  property channelId: String;
  property lastSyncTimestamp: Real;

  invariants {
    self.channelId <> null;
    self.lastSyncTimestamp >= 0.0;
  }

  // Propagate timer reading
  event syncPedestrianTimer(timestamp: Real) {
    pre: timestamp >= 0.0;
    post: self.lastSyncTimestamp = timestamp;
    modifies: self.lastSyncTimestamp;
  }
}

relator SafetyTimeoutChannel mediates (SafetyMonitorTimerRole, SafetyTimerServiceRole) {
  identity: channelId;
  property channelId: String;
  property lastSyncTimestamp: Real;

  invariants {
    self.channelId <> null;
    self.lastSyncTimestamp >= 0.0;
  }

  // Propagate timer reading
  event syncSafetyTimer(timestamp: Real) {
    pre: timestamp >= 0.0;
    post: self.lastSyncTimestamp = timestamp;
    modifies: self.lastSyncTimestamp;
  }
}

// ─── Happenings (end-to-end data flows) ──────────────────────────────

// Normal phase cycle: PhaseManager + TimerService
happening NormalPhaseCycleFlow {
  identity: flowId;
  property flowId: String;
  property managerId: String;
  property timerId: String;
  property startPhaseId: String;
  property yellowDurationSeconds: Real;
  property allRedDwellSeconds: Real;
  property targetPhaseId: String;

  invariants {
    self.flowId <> null;
    self.yellowDurationSeconds >= 3.0;
    self.allRedDwellSeconds > 0.0;
    self.startPhaseId <> null;
    self.targetPhaseId <> null;
  }
}

// Emergency preemption flow: SafetyMonitor + TimerService + PhaseManager
happening EmergencyPreemptionFlowDesign {
  identity: flowId;
  property flowId: String;
  property monitorId: String;
  property managerId: String;
  property timerId: String;
  property responseTimeSeconds: Real;

  invariants {
    self.flowId <> null;
    self.responseTimeSeconds <= 1.0;
    self.monitorId <> null;
    self.managerId <> null;
  }
}

// Pedestrian request flow: PedestrianModule + TimerService (for dwell)
happening PedestrianRequestFlowDesign {
  identity: flowId;
  property flowId: String;
  property moduleId: String;
  property timerId: String;
  property requestTimestamp: Real;
  property walkGranted: Boolean;

  invariants {
    self.flowId <> null;
    self.requestTimestamp > 0.0;
    self.moduleId <> null;
  }
}

// ─── Explicit Relations ──────────────────────────────────────────────
relation phaseManagerMed: <<mediation>> from PhaseTimerChannel [1] to PhaseManagerRole [1];
relation timerServiceMed: <<mediation>> from PhaseTimerChannel [1] to TimerServiceRole [1];
relation pedTimerMed: <<mediation>> from PedestrianTimerChannel [1] to PedestrianModuleRole [1];
relation pedTSMed: <<mediation>> from PedestrianTimerChannel [1] to PedestrianTimerServiceRole [1];
relation safetyMonMed: <<mediation>> from SafetyTimeoutChannel [1] to SafetyMonitorTimerRole [1];
relation safetyTSMed: <<mediation>> from SafetyTimeoutChannel [1] to SafetyTimerServiceRole [1];
