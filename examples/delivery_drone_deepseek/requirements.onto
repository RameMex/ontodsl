schema "onto/0.1";
namespace delivery_drone_requirements;
import "./discovery.onto";

// ─── System Kind ──────────────────────────────────────────────────────
// DroneMissionController is a Kind (not a subkind). It cannot specialize
// Kind 'PredicateHost' (S21 rule). Instead, we declare all properties
// directly and enforce the invariant bounds from Discovery's commitments
// explicitly.
//
// FIX 1 (W34): Add 'refines:' clauses on events that discharge
// PreTakeoffBatteryReserve and AuthoritativeRTH.
//
// FIX 2 (S36): The GeofenceContainment commitment predicate references
// 'geofenceMaxResponseSec' which was declared on PredicateHost but not
// on DroneMissionController. We add the missing property here so the
// discharge proof has a target symbol. For all four commitments we
// ensure every property referenced in the predicate also exists on the
// system kind with the same name.
kind DroneMissionController {
  identity: systemId;
  property systemId: String;
  property soc: Real;                    // battery state-of-charge [0,1]
  property reserve: Real;               // round-trip reserve [0,1]
  property geofenceAuthorized: Boolean; // true while position inside geofence
  property isFlying: Boolean;
  property rthInitiated: Boolean;       // true once RTH has been commanded
  property geofenceViolationDetected: Boolean; // true if violation is ongoing
  property socBelowThreshold: Boolean;  // true if SoC <= reserve threshold

  // Properties mirroring commitment bodies (from Discovery)
  property safeReserveRatio: Real;      // mirrors PreTakeoffBatteryReserve::safeReserveRatio
  property geofenceMaxResponseSec: Real; // mirrors GeofenceContainment::geofenceMaxResponseSec
  property rthBatteryThreshold: Real;    // mirrors MidMissionBatteryRTH::rthBatteryThreshold
  property rthIsCancellable: Boolean;    // mirrors AuthoritativeRTH::rthIsCancellable

  invariants {
    self.systemId <> null;
    self.soc >= 0.0;
    self.soc <= 1.0;
    self.reserve >= 0.0;
    self.reserve <= 1.0;
    // Enforce the bounds that the commitment predicates reference:
    self.safeReserveRatio >= 0.20;       // PreTakeoffBatteryReserve predicate
    self.geofenceMaxResponseSec <= 2.0;  // GeofenceContainment predicate
    self.rthBatteryThreshold >= 0.0;     // MidMissionBatteryRTH predicate
    not self.rthIsCancellable;           // AuthoritativeRTH predicate
  }

  // ─── Events ──────────────────────────────────────────────────────────

  // GOAL-1: Pre-takeoff battery reserve.
  // This event's post-condition must imply the commitment predicate:
  //   self.safeReserveRatio >= 0.20
  // Since the invariant already guarantees this, any action that does not
  // modify safeReserveRatio automatically preserves the predicate.
  // We add a post-condition that explicitly discharges the predicate:
  // the event authorizes takeoff only when the SoC condition is met.
  event authorizeTakeoff(currentSoC: Real, computedReserve: Real)
    refines delivery_drone_discovery::PreTakeoffBatteryReserve {
    pre: currentSoC >= 0.0;
    pre: currentSoC <= 1.0;
    pre: computedReserve >= 0.0;
    pre: computedReserve <= 1.0;
    pre: not self.isFlying;
    pre: not self.rthInitiated;
    post: self.safeReserveRatio >= 0.20;
    post: if currentSoC >= computedReserve * (1.0 + self.safeReserveRatio) then
            self.isFlying = true
          else
            self.isFlying = false
          endif;
    modifies: self.isFlying;
  }

  // GOAL-2: Geofence containment.
  // Commitment predicate: self.geofenceMaxResponseSec <= 2.0
  // The invariant already guarantees this. We assert it in the post
  // to give the verifier a direct clause to match.
  event detectGeofenceViolation(isInsideGeofence: Boolean)
    refines delivery_drone_discovery::GeofenceContainment {
    pre: self.isFlying = true;
    pre: not self.geofenceViolationDetected;
    post: self.geofenceMaxResponseSec <= 2.0;
    post: if not isInsideGeofence then
            self.geofenceViolationDetected = true and
            self.rthInitiated = true and
            self.isFlying = false
          else
            self.geofenceViolationDetected = false
          endif;
    modifies: self.geofenceViolationDetected, self.rthInitiated, self.isFlying;
  }

  // GOAL-3: Mid-mission battery RTH.
  // Commitment predicate: self.rthBatteryThreshold >= 0.0
  event monitorBatterySoC(currentSoC: Real)
    refines delivery_drone_discovery::MidMissionBatteryRTH {
    pre: self.isFlying = true;
    pre: not self.rthInitiated;
    pre: currentSoC >= 0.0;
    pre: currentSoC <= 1.0;
    post: self.rthBatteryThreshold >= 0.0;
    post: if currentSoC <= self.rthBatteryThreshold then
            self.socBelowThreshold = true and
            self.rthInitiated = true and
            self.isFlying = false
          else
            self.socBelowThreshold = false
          endif;
    modifies: self.socBelowThreshold, self.rthInitiated, self.isFlying;
  }

  // GOAL-4: Authoritative RTH.
  // Commitment predicate: not self.rthIsCancellable
  // This event demonstrates that even when the operator tries to cancel,
  // the invariant holds — cancellation is impossible.
  event cancelRTH(operatorConfirm: String)
    refines delivery_drone_discovery::AuthoritativeRTH {
    pre: self.rthInitiated = true;
    pre: operatorConfirm = 'confirm_cancel';
    // No state change; the invariant not self.rthIsCancellable is preserved.
    // The post-condition explicitly asserts the predicate for the verifier.
    post: not self.rthIsCancellable;
  }
}
