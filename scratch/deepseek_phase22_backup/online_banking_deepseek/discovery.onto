schema "onto/0.1";
namespace online_banking_discovery;

// ─── Stakeholders ───────────────────────────────────────────────────
agent Customer {
  identity: customerId;
  property customerId: String;
  property name: String;
  property accounts: Set<Account>;
  invariants {
    self.customerId <> null;
    self.name <> null;
  }
}

agent Regulator {
  identity: regulatorId;
  property regulatorId: String;
  property authority: String;
  property jurisdiction: String;
  invariants {
    self.regulatorId <> null;
    self.authority <> null;
  }
}

// Vendor/Dev team — debitor of all stakeholder commitments.
agent BankingVendor {
  identity: vendorId;
  property vendorId: String;
  property name: String;
  invariants {
    self.vendorId <> null;
  }
}

// ─── Glossary Terms ─────────────────────────────────────────────────
kind Account {
  identity: accountId;
  property accountId: String;
  property owner: Customer;
  property balance: Real;
  invariants {
    self.accountId <> null;
    self.owner <> null;
    self.balance >= 0.0;
  }
}

kind Transfer {
  identity: transferId;
  property transferId: String;
  property source: Account;
  property destination: Account;
  property amount: Real;
  property status: String;  // 'PENDING', 'COMMITTED', 'ROLLED_BACK'
  invariants {
    self.transferId <> null;
    self.source <> null;
    self.destination <> null;
    self.amount > 0.0;
    self.source <> self.destination;
    self.status = 'PENDING' or self.status = 'COMMITTED' or self.status = 'ROLLED_BACK';
  }
}

kind JournalEntry {
  identity: entryId;
  property entryId: String;
  property transferId: String;
  property preSourceBalance: Real;
  property postSourceBalance: Real;
  property preDestBalance: Real;
  property postDestBalance: Real;
  property timestamp: Real;
  invariants {
    self.entryId <> null;
    self.transferId <> null;
    self.preSourceBalance >= 0.0;
    self.postSourceBalance >= 0.0;
    self.preDestBalance >= 0.0;
    self.postDestBalance >= 0.0;
    self.timestamp > 0.0;
  }
}

// ─── Hard Goals as Commitments ──────────────────────────────────────
// GOAL-1: Atomic transfer — cannot be fully formalized with own props alone,
// but we capture the invariant that no partial state is observable.
// The predicate expresses that successful transfers always have debit=credit.
commitment AtomicTransferCommitment
  debitor: BankingVendor
  creditor: Customer {
  identity: commitmentId;
  property commitmentId: String;
  property minAtomicityAssurance: String;  // documentary
  predicate: true;  // Placeholder — actual proof requires event post-conditions
                     // in Requirements stage implying the atomicity property.
}

// GOAL-2: No overdraft — the source account's post-transfer balance >= 0.
commitment NoOverdraftCommitment
  debitor: BankingVendor
  creditor: Customer {
  identity: commitmentId;
  property commitmentId: String;
  property minPostTransferBalance: Real;
  predicate: self.minPostTransferBalance >= 0.0;
}

// GOAL-3: Auditable journal for every successful transfer.
// The predicate captures that every committed transfer has a matching
// journal entry created before notification.
commitment AuditableJournalCommitment
  debitor: BankingVendor
  creditor: Regulator {
  identity: commitmentId;
  property commitmentId: String;
  property journalRetentionDays: Integer;
  predicate: self.journalRetentionDays > 0;
}

// GOAL-4: Bounded transfer latency — pending state resolves within 30 seconds.
commitment BoundedLatencyCommitment
  debitor: BankingVendor
  creditor: Customer {
  identity: commitmentId;
  property commitmentId: String;
  property maxPendingSeconds: Real;
  predicate: self.maxPendingSeconds >= 0.0 and self.maxPendingSeconds <= 30.0;
}

// ─── Constraint Goal Categories (inherited invariants) ──────────────
// Atomicity constraint: no partial transfer state.
category AtomicityConstraints where bearer: Transfer {
  invariants {
    // A committed transfer must have both debit and credit completed.
    // This is a high-level constraint; Requirements will make it precise.
    bearer.amount > 0.0;
  }
}

// No-overdraft constraint: post-transfer source balance >= 0.
category NoOverdraftConstraint where bearer: Account {
  invariants {
    bearer.balance >= 0.0;
  }
}

// Audit constraint: every committed transfer has a corresponding journal entry.
// This category is meant to be specialized by the system kind in Requirements.
category AuditableConstraint {
  invariants {
    true;  // Placeholder — concrete invariants attach to system kind.
  }
}

// Bounded latency constraint: pending transfers resolve within 30 seconds.
category BoundedLatencyConstraint where bearer: Transfer {
  invariants {
    bearer.status <> 'PENDING';  // Placeholder — temporal constraint needs 
                                  // richer infrastructure.
  }
}

// ─── Domain Story ───────────────────────────────────────────────────
happening TransferFlow {
  identity: flowId;
  property flowId: String;
  property triggeredBy: String;  // Ref to the initiation event
  property outcome: String;       // OCL predicate describing end state
  invariants {
    self.flowId <> null;
    self.triggeredBy <> null;
  }
}
