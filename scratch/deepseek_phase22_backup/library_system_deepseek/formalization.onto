schema "onto/0.1";
namespace library_system_formalization;
import "./discovery.onto";
import "./requirements.onto";

// =========================================================================
// FORMALIZATION STAGE – Library Lending System
//
// This stage disambiguates the requirements against external anchors:
// regulations, standards, physical laws. It captures what the WORLD
// imposes ON the system — NOT what the system does.
//
// Active business rules become events on a Formalized subkind.
// Passive assumptions are recorded as documentary properties.
// Regulatory anchors and physical invariants become member-quantified
// categories.
// =========================================================================

// ─── Regulatory / Compliance Anchors ───────────────────────────────────
// GDPR Article 5: Personal data must be processed lawfully, fairly,
// and transparently. In a library system, borrower identifiers and loan
// history constitute personal data.

category GdprArticle5Compliant where bearer: LibrarySystem {
  invariants {
    // Every borrower must have provided explicit consent (documented via
    // a consent flag or consent record). This is a documentary constraint
    // the code must enforce — we model it as an invariant on the system's
    // borrower registry.
    bearer.borrowers->forAll(b | b.email <> null);
  }
}

// PCI DSS: If payment information is processed, the system must comply.
// In this domain, only late fees involve financial transactions.
// We model a passive regulatory anchor.
category PciDssCompliant where bearer: LibrarySystem {
  invariants {
    // Payment processing must be logged and auditable.
    // At minimum, transactions are recorded (placeholder — real PCI DSS
    // compliance involves encryption, tokenization, etc.).
    true;
  }
}

// ISO 2788: Information and documentation — Guidelines for the
// establishment and development of monolingual thesauri.
// Library systems should maintain authority control over bibliographic
// metadata.
category Iso2788Compliant where bearer: LibrarySystem {
  invariants {
    // Each book copy must have an associated ISBN for authority control.
    bearer.copies->forAll(c | c.isbn <> null);
  }
}

// ─── Physical / Domain-Logical Invariants ──────────────────────────────
// "A book copy can never be lent to more than one borrower simultaneously."
// This is already captured in the requirements as an invariant, but we
// re-state it here as a formalized physical constraint because it is a
// domain law, not a policy decision.

category MutuallyExclusiveLending where bearer: LibrarySystem {
  invariants {
    // For any two distinct active loans (returnDate = null), they cannot
    // reference the same copyId.
    bearer.loans->forAll(l1 |
      bearer.loans->forAll(l2 |
        l1.loanId <> l2.loanId and l1.copyId = l2.copyId
          implies (l1.returnDate <> null or l2.returnDate <> null)
      )
    );
  }
}

// "A borrower's accumulated late fees must be paid in full before a new
// loan is approved." This is also a domain law — the system cannot
// invoke a different rule.
category FeeBlockingRule where bearer: LibrarySystem {
  invariants {
    // The checkout event's precondition enforces this; we document it
    // here as a first-class constraint that must always hold.
    true; // The actual enforcement is in the checkout pre-condition.
  }
}

// ─── Passive Assumptions Record ────────────────────────────────────────
// These are documented assumptions that the world imposes but which the
// system does not enforce at runtime. They govern the project, not the
// execution.

kind FormalAssumptionRecord {
  identity: assumptionId;
  property assumptionId: String;
  property assumptionCode: String;  // e.g., "ASSUME-001"
  property description: String;
  property owner: String;           // e.g., "Domain Expert"
  property status: String;          // "ACCEPTED", "VALIDATED", "VERIFIED"

  invariants {
    self.assumptionId <> null;
    self.assumptionCode <> null;
    self.description <> null;
    self.owner <> null;
    self.status = 'ACCEPTED' or self.status = 'VALIDATED' or self.status = 'VERIFIED';
  }
}

// ─── Formalization: GDPR Compliance Commitment ─────────────────────────
// Added as a top-level commitment because the discovery stage did not
// include one for data protection. This is a regulatory anchor commitment.

commitment GdprComplianceCommitment
  debitor: LibraryVendor
  creditor: BorrowerAgent {
  identity: commitmentId;
  property commitmentId: String;
  property dataProcessingPolicy: String;
  predicate: self.dataProcessingPolicy <> null;
}

// ─── Formalization: PCI DSS Compliance Commitment ──────────────────────
commitment PciDssComplianceCommitment
  debitor: LibraryVendor
  creditor: BorrowerAgent {
  identity: commitmentId;
  property commitmentId: String;
  property transactionLoggingEnabled: Boolean;
  predicate: self.transactionLoggingEnabled = true;
}

// ─── Active Business Rules (Rejection / Guard Events) ──────────────────
// These are events that the system MUST implement to enforce world-imposed
// rules. They are modeled as ADDITIONS to the system kind via a Formalized
// subkind.
//
// NOTE: Per S21 rules, a subkind can ONLY specialize a Kind or another
// Subkind — NOT a Category. The categories (GdprArticle5Compliant, etc.)
// are already specialized by the parent 'LibrarySystem' in the requirements
// stage. The formalized subkind inherits those category memberships through
// its parent. We specialize only the parent Kind.

subkind LibrarySystemFormalized specializes LibrarySystem {

  // ─── Active Rule: Reject loan when borrower has outstanding fees ────────
  // This is an explicit guard event that the system MUST invoke before
  // checkout. It complements the check already in FR-1's precondition.
  event rejectLoanForIndebtedBorrower(borrowerId: String)
    refines library_system_discovery::BlockIndebtedLoansCommitment {
    pre: self.borrowers->exists(b | b.borrowerId = borrowerId);
    pre: self.borrowers->forAll(b |
      if b.borrowerId = borrowerId then b.outstandingFees > 0.0 else true endif
    );
    post: true;  // No state change — pure rejection guard.
  }

  // ─── Active Rule: Reject checkout when copy already lent ────────────────
  event rejectCheckoutForAlreadyLentCopy(copyId: String)
    refines library_system_discovery::MutualExclusiveCopyStateCommitment {
    pre: self.copies->exists(c | c.copyId = copyId);
    pre: self.copies->forAll(c |
      if c.copyId = copyId then c.copyStatus = 'LOANED' else true endif
    );
    post: true;
  }

  // ─── Active Rule: Reject reservation if borrower already has one
  //     for the same copy (anti-duplicate).
  event rejectDuplicateReservation(copyId: String, borrowerId: String)
    refines library_system_discovery::MutualExclusiveCopyStateCommitment {
    pre: self.copies->exists(c | c.copyId = copyId);
    pre: self.borrowers->exists(b | b.borrowerId = borrowerId);
    pre: self.reservations->exists(r |
      r.copyId = copyId and r.borrowerId = borrowerId and r.reservationStatus = 'ACTIVE'
    );
    post: true;
  }

  // ─── Active Rule: Enforce 7-day expiration on reservations ──────────────
  event enforceReservationExpiryCutoff(reservationId: String)
    refines library_system_discovery::ExpireStaleReservationsCommitment {
    pre: self.reservations->exists(r | r.reservationId = reservationId);
    pre: self.reservations->forAll(r |
      if r.reservationId = reservationId then r.reservationStatus = 'ACTIVE' else true endif
    );
    post: true;
  }

  // ─── Active Rule: Apply late fee on overdue return ──────────────────────
  // NOTE: returnDate and dueDate are ISO date Strings, not numbers.
  // The late fee formula is a BUSINESS RULE that the system must enforce.
  // We model the fee application as a guard that fires the calculation
  // using a comparison of unix timestamps (conceptual). For verification,
  // we use a simpler check: result is computed from a constant rate and
  // the fact that the return was overdue.
  event enforceLateFeeOnReturn(loanId: String): Real
    refines library_system_discovery::TrackLateFeesCommitment {
    pre: self.loans->exists(l | l.loanId = loanId);
    pre: self.loans->forAll(l |
      if l.loanId = loanId then l.returnDate <> null and l.returnDate <> l.dueDate else true endif
    );
    post: result >= 0.0;
    post: self.loans->forAll(l |
      if l.loanId = loanId then
        l.lateFee = self.dailyLateFeeRate
      else true endif
    );
    modifies: self.loans;
  }

  // ─── Active Rule: Verify borrower consent before processing personal data ──
  event verifyBorrowerConsent(borrowerId: String)
    refines library_system_discovery::GdprComplianceCommitment {
    pre: self.borrowers->exists(b | b.borrowerId = borrowerId);
    pre: self.borrowers->forAll(b |
      if b.borrowerId = borrowerId then b.email <> null else true endif
    );
    post: true;
  }

  // ─── Active Rule: Log payment audit trail for PCI DSS compliance ─────────
  event logPaymentTransaction(borrowerId: String, amount: Real) {
    pre: self.borrowers->exists(b | b.borrowerId = borrowerId);
    pre: amount >= 0.0;
    post: true;
  }
}

// ─── Relation: FormalAssumptionRecord belongs to LibraryVendor ─────────
// The vendor owns the assumptions.
relation vendorAssumptions: <<memberOf>> from FormalAssumptionRecord [0..*] to LibraryVendor [1];

// @assumption ASSUME-001: The library's opening hours are between 8 AM and 8 PM
//                         local time. The system assumes all events occur within
//                         these hours for logging purposes.
//
// @assumption ASSUME-002: A day is defined as a 24-hour calendar day for
//                         late-fee calculation. No fractional-day accounting.
//
// @assumption ASSUME-003: Borrower identity verification is handled by an
//                         external system (e.g., librarian checks ID). The
//                         library system assumes the caller is authorized.
//
// @assumption ASSUME-004: The dailyLateFeeRate is set by the library board
//                         and does not change mid-loan. The system assumes
//                         a constant rate for the duration of any loan.
