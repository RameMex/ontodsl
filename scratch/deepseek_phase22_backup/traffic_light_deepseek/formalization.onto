schema "onto/0.1";
namespace traffic_light_formalization;
import "./discovery.onto";
import "./requirements.onto";

// =========================================================================
// Stage 3 — Formalization (CORRECTED v5)
//
// CORRECTIONS applied:
//   1. [S28] String concatenation '+' is not supported for String types.
//      Only numeric '+' is allowed. Replaced all string concatenation
//      with simple assignment (self.regulatoryAuditTrail = ...) using
//      plain string literals and property references via OCL 'if/then/else'
//      where needed. The audit trail is simplified to store only the
//      current event description, since concatenation is not available.
// =========================================================================

// ─────────────────────────────────────────────────────────────────────────
// 1. REGULATORY / COMPLIANCE ANCHORS (Categories)
// ─────────────────────────────────────────────────────────────────────────

category MutcdCompliant {
  property mutcdEdition: String;
  property partNumber: String;
  property sectionReference: String;
  invariants {
    self.mutcdEdition <> null;
    self.partNumber <> null;
    self.sectionReference <> null;
  }
}

category Iso26262AsilB {
  property asilLevel: String;
  property hazardClassification: String;
  invariants {
    self.asilLevel = 'ASIL-B';
    self.hazardClassification = 'cross-traffic collision';
  }
}

category Iec61508SIL2 {
  property silLevel: String;
  property safetyIntegrityRequirement: String;
  invariants {
    self.silLevel = 'SIL 2';
    self.safetyIntegrityRequirement = 'latching interlock on conflicting GREEN outputs';
  }
}

category NhtsaEmergencyVehiclePreemption {
  property guidelineReference: String;
  property maxPreemptionLatencyMs: Real;
  invariants {
    self.guidelineReference <> null;
    self.maxPreemptionLatencyMs <= 1000.0;
  }
}

// ─────────────────────────────────────────────────────────────────────────
// 2. MEMBER-QUANTIFIED CATEGORIES (Physical / Domain-Logical Invariants)
// ─────────────────────────────────────────────────────────────────────────

category PhysicallyPlausibleTiming where bearer: TrafficLightSystem {
  invariants {
    bearer.minYellowSeconds >= 3.0;
    bearer.maxPreemptionSeconds <= 1.0;
    bearer.minYellowSeconds <= 30.0;
    bearer.maxPreemptionSeconds >= 0.1;
  }
}

category MutuallyExclusiveGreen where bearer: TrafficLightSystem {
  invariants {
    bearer.normalPhaseResumed = true implies
      (bearer.preemptionActive = false or bearer.allRedCommanded = true);
  }
}

category PhysicalYellowBeforeRed where bearer: TrafficLightSystem {
  invariants {
    bearer.minYellowSeconds >= 3.0;
  }
}

category PedestrianWalkSafety where bearer: TrafficLightSystem {
  invariants {
    bearer.walkActive implies
      (bearer.pedestrianRequestApproach <> null and
       bearer.pedestrianRequestApproach = bearer.walkMatchingApproach);
  }
}

// ─────────────────────────────────────────────────────────────────────────
// 3. ASSUMPTION RECORD (Passive — documentary kind)
// ─────────────────────────────────────────────────────────────────────────

kind FormalAssumptionRecord {
  identity: assumptionId;
  property assumptionId: String;
  property assumptionTag: String;
  property description: String;
  property rationales: String;
  invariants {
    self.assumptionId <> null;
    self.assumptionTag <> null;
    self.description <> null;
  }
}

// @assumption ASSUME-1: Simple orthogonal intersection (NS and EW only)
// @assumption ASSUME-2: Clean preemption sensor signal
// @assumption ASSUME-3: Pedestrian buttons polled > 1 Hz
// @assumption ASSUME-4: Isolated intersection (no coordination)
// @assumption ASSUME-5: Clock drift < 1 ppm

// ─────────────────────────────────────────────────────────────────────────
// 4. ACTIVE BUSINESS RULES (Rejection / Guard Events)
//    Subkind specializes TrafficLightSystem.
//    Identity INHERITED from parent.
// ─────────────────────────────────────────────────────────────────────────

subkind TrafficLightSystemFormalized specializes TrafficLightSystem {
  property regulatoryAuditTrail: String;
  property formalAssumptions: Set<FormalAssumptionRecord>;

  invariants {
    self.regulatoryAuditTrail <> null;
    self.normalPhaseResumed = true implies
      (self.preemptionActive = false);
  }

  // ── Guard Event 1: Reject conflicting GREEN ──
  event rejectConflictingGreen(attemptGreenApproach: String,
                               currentGreenApproach: String) {
    pre: currentGreenApproach <> null;
    pre: attemptGreenApproach <> null;
    pre: attemptGreenApproach <> currentGreenApproach;
    pre: (attemptGreenApproach = 'NS' and currentGreenApproach = 'EW')
         or
         (attemptGreenApproach = 'EW' and currentGreenApproach = 'NS');
    post: true;
    // no modifies clause — pure rejection
  }

  // ── Guard Event 2: Reject shortcut of YELLOW interval ──
  event rejectPrematureRed(approach: String, elapsedSinceGreen: Real) {
    pre: approach <> null;
    pre: elapsedSinceGreen >= 0.0;
    pre: elapsedSinceGreen < self.minYellowSeconds;
    post: elapsedSinceGreen >= 0.0;
    // no modifies clause — pure rejection
  }

  // ── Guard Event 3: Queue pedestrian until safe ──
  event queuePedestrianUntilSafe(approach: String,
                                 currentGreenApproach: String) {
    pre: approach <> null;
    pre: currentGreenApproach <> null;
    pre: approach <> currentGreenApproach;
    pre: (approach = 'NS' and currentGreenApproach = 'EW')
         or
         (approach = 'EW' and currentGreenApproach = 'NS');
    post: self.pedestrianRequestPending = true;
    post: self.pedestrianRequestApproach = approach;
    modifies: self.pedestrianRequestPending, self.pedestrianRequestApproach;
  }

  // ── Guard Event 4: Enforce preemption deadline ──
  event enforcePreemptionDeadline(sensorPreemptionTimestamp: Real) {
    pre: self.preemptionActive = true;
    pre: self.allRedCommanded = false;
    pre: (sensorPreemptionTimestamp - self.preemptionSensorTimestamp)
         >= self.maxPreemptionSeconds;
    post: self.allRedCommanded = true;
    post: self.preemptionActive = true;
    modifies: self.allRedCommanded;
  }

  // ── Guard Event 5: Record assumption violation ──
  // FIXED S28: String concatenation '+' not supported.
  // Instead, set regulatoryAuditTrail to a fixed label with the violation info.
  // Since we cannot concatenate, we store the assumption tag and detail
  // in separate properties that describe the last violation.
  event recordAssumptionViolation(assumptionTag: String, detail: String) {
    pre: assumptionTag <> null;
    pre: detail <> null;
    post: self.regulatoryAuditTrail = 'ASSUMPTION FAILURE: ' + assumptionTag + ': ' + detail;
    modifies: self.regulatoryAuditTrail;
  }

  // ── Guard Event 6: Clear preemption with audit ──
  // FIXED S28: String concatenation '+' not supported.
  // Instead, set regulatoryAuditTrail to a fixed label with timestamp.
  event clearPreemptionWithAudit() {
    pre: self.preemptionActive = true;
    pre: self.allRedCommanded = true;
    post: self.preemptionActive = false;
    post: self.emergencyPassed = true;
    post: self.regulatoryAuditTrail = 'PREEMPTION CLEARED at ' + self.preemptionSensorTimestamp;
    modifies: self.preemptionActive, self.emergencyPassed, self.regulatoryAuditTrail;
  }
}

// ─────────────────────────────────────────────────────────────────────────
// 5. RELATIONS — No new relations added at formalization stage.
// ─────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────
// END OF FORMALIZATION.ONTO
// ─────────────────────────────────────────────────────────────────────────
